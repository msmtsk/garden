---
import { typeBadgeClass } from '../utils';

interface Product {
  id: string;
  name: string;
  category: string;
  type: string;
  price: number;
  inStock: boolean;
  quantity: number;
  description?: string;
  author?: string;
  attributes?: Record<string, string>;
}

interface Props {
  product: Product;
  base: string;
}

const { product, base } = Astro.props;
const badgeClass = typeBadgeClass(product.type);
const _allImgs = import.meta.glob('/public/images/**/*.{jpg,jpeg,png,webp,gif}');
const _productImgs = Object.keys(_allImgs)
  .filter(p => p.startsWith(`/public/images/${product.id}/`))
  .sort();
const imgSrc = _productImgs.length
  ? _productImgs[0].replace('/public', base || '')
  : `${base}/images/${product.id}/1.jpg`;
---

<article class="card" data-id={product.id}>
  <a href={`${base}/product/${product.id}`} class="card-link">
    <div class="card-img">
      <img
        src={imgSrc}
        alt={product.name}
        class="card-photo"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
      />
      <div class="card-photo-placeholder" style="display:none">🌿</div>

      <span class={`badge ${badgeClass} card-type`}>{product.type}</span>
      <span class={`card-avail ${product.inStock ? 'avail-yes' : 'avail-no'}`}></span>
    </div>

    <div class="card-body">
      <div class="card-name">{product.name}</div>
      {product.description && (
        <div class="card-desc">{product.description}</div>
      )}
      <div class="card-footer">
        <span class="card-price">{product.price} ₽</span>
        {product.inStock
          ? <span class="card-btn-hint">В корзину</span>
          : <span class="card-sold">Нет в наличии</span>
        }
      </div>
    </div>
  </a>

  {product.inStock && (
    <button
      class="card-add-btn"
      data-id={product.id}
      data-name={product.name}
      data-type={product.type}
      data-price={product.price}
    >
      + В корзину
    </button>
  )}
</article>

<style>
  .card {
    background: #fff;
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover { border-color: var(--border-hover); transform: translateY(-2px); }

  .card-link { text-decoration: none; color: inherit; display: flex; flex-direction: column; flex: 1; }

  .card-img {
    position: relative; height: 200px;
    background: #f5f0fa;
    display: flex; align-items: center; justify-content: center;
  }
  .card-photo { width: 100%; height: 100%; object-fit: cover; }
  .card-photo-placeholder { font-size: 52px; opacity: 0.4; width: 100%; height: 100%; align-items: center; justify-content: center; }

  .card-type { position: absolute; top: 10px; left: 10px; }
  .card-avail {
    position: absolute; top: 12px; right: 12px;
    width: 8px; height: 8px; border-radius: 50%;
  }
  .avail-yes { background: #4CAF82; }
  .avail-no { background: #ccc; }

  .card-body { padding: 12px 14px 14px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .card-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px; font-weight: 500; line-height: 1.25;
  }
  .card-desc {
    font-size: 12px; color: var(--text-muted); line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    flex: 1;
  }
  .card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
  .card-price { font-size: 16px; font-weight: 500; }
  .card-btn-hint { font-size: 12px; color: var(--green); }
  .card-sold { font-size: 12px; color: var(--text-faint); }

  .card-add-btn {
    width: 100%; border: none; border-top: 0.5px solid var(--border);
    background: none; padding: 10px;
    font-size: 13px; font-weight: 500; color: var(--green);
    cursor: pointer; font-family: 'DM Sans', sans-serif;
    transition: background 0.15s;
  }
  .card-add-btn:hover { background: var(--green-light); }
  .card-add-btn.added { color: #fff; background: var(--green); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.card-add-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const { id, name, type, price } = btn.dataset;
      const cart = JSON.parse(localStorage.getItem('mg-cart') || '[]');
      const existing = cart.find((i: any) => i.id === id);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ id, name, type, price: Number(price), qty: 1 });
      }
      localStorage.setItem('mg-cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('mg-cart-updated'));

      btn.textContent = '✓ Добавлено';
      btn.classList.add('added');
      setTimeout(() => {
        btn.textContent = '+ В корзину';
        btn.classList.remove('added');
      }, 1500);
    });
  });
</script>

---
import { typeBadgeClass } from '../utils';
import { readdirSync } from 'fs';
import { join } from 'path';

interface Product {
  id: string;
  name: string;
  category: string;
  type: string;
  price: number;
  inStock: boolean;
  quantity: number;
  description?: string;
  author?: string;
  attributes?: Record<string, string>;
}

interface Props {
  product: Product;
  base: string;
}

const { product, base } = Astro.props;
const badgeClass = typeBadgeClass(product.type);
const rozetteSize = (product as any).attributes?.rozetteSize;

// Get first image alphabetically from public/images/{id}/
function getFirstImage(id: string, base: string): string {
  try {
    const dir = join(process.cwd(), 'public', 'images', id);
    const files = readdirSync(dir)
      .filter((f: string) => /\.(jpg|jpeg|png|webp|gif)$/i.test(f))
      .sort();
    if (files.length > 0) return `${base}/images/${id}/${files[0]}`;
  } catch {}
  return `${base}/images/${id}/1.jpg`;
}

const imgSrc = getFirstImage(product.id, base);
---

<article class="card" data-id={product.id}>
  <a href={`${base}/product/${product.id}`} class="card-link">
    <div class="card-img">
      <img
        src={imgSrc}
        alt={product.name}
        class="card-photo"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
      />
      <div class="card-photo-placeholder" style="display:none">🌿</div>
      <span class={`badge ${badgeClass} card-type`}>{product.type}</span>
      <span class={`card-avail ${product.inStock ? 'avail-yes' : 'avail-no'}`}></span>
    </div>

    <div class="card-body">
      <div class="card-name">{product.name}</div>
      {rozetteSize && (
        <div class="card-rozette">{rozetteSize}</div>
      )}
      <div class="card-footer">
        <span class="card-price">{product.price} ₽</span>
        {product.inStock
          ? <span class="card-btn-hint">В корзину</span>
          : <span class="card-sold">Нет в наличии</span>
        }
      </div>
    </div>
  </a>

  {product.inStock && (
    <button
      class="card-add-btn"
      data-id={product.id}
      data-name={product.name}
      data-type={product.type}
      data-price={product.price}
    >
      + В корзину
    </button>
  )}
</article>

<style>
  .card {
    background: #fff;
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover { border-color: var(--border-hover); transform: translateY(-2px); }
  .card-link { text-decoration: none; color: inherit; display: flex; flex-direction: column; flex: 1; }
  .card-img {
    position: relative; height: 280px;
    background: #f5f0fa;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .card-photo { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .card-photo-placeholder { font-size: 52px; opacity: 0.4; width: 100%; height: 100%; align-items: center; justify-content: center; }
  .card-type { position: absolute; top: 10px; left: 10px; }
  .card-avail { position: absolute; top: 12px; right: 12px; width: 8px; height: 8px; border-radius: 50%; }
  .avail-yes { background: #4CAF82; }
  .avail-no { background: #ccc; }
  .card-body { padding: 10px 14px 12px; display: flex; flex-direction: column; gap: 4px; }
  .card-name { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-weight: 500; line-height: 1.25; }
  .card-rozette { font-size: 11px; color: var(--text-faint); letter-spacing: 0.03em; }
  .card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 6px; }
  .card-price { font-size: 16px; font-weight: 500; }
  .card-btn-hint { font-size: 12px; color: var(--green); }
  .card-sold { font-size: 12px; color: var(--text-faint); }
  .card-add-btn {
    width: 100%; border: none; border-top: 0.5px solid var(--border);
    background: none; padding: 10px;
    font-size: 13px; font-weight: 500; color: var(--green);
    cursor: pointer; font-family: 'DM Sans', sans-serif;
    transition: background 0.15s, color 0.15s;
  }
  .card-add-btn:hover { background: var(--green-light); }
  .card-add-btn.in-cart { color: #fff; background: var(--green); }
</style>

<script>
  function syncCartButtons() {
    const cart: any[] = JSON.parse(localStorage.getItem('mg-cart') || '[]');
    const inCartIds = new Set(cart.map((i: any) => i.id));
    document.querySelectorAll<HTMLButtonElement>('.card-add-btn').forEach(btn => {
      const id = btn.dataset.id!;
      if (inCartIds.has(id)) {
        btn.textContent = '✓ В корзине';
        btn.classList.add('in-cart');
      } else {
        btn.textContent = '+ В корзину';
        btn.classList.remove('in-cart');
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.card-add-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const { id, name, type, price } = btn.dataset;
      let cart: any[] = JSON.parse(localStorage.getItem('mg-cart') || '[]');
      const existingIdx = cart.findIndex((i: any) => i.id === id);
      if (existingIdx >= 0) {
        cart.splice(existingIdx, 1);
      } else {
        cart.push({ id, name, type, price: Number(price), qty: 1 });
      }
      localStorage.setItem('mg-cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('mg-cart-updated'));
      syncCartButtons();
    });
  });

  syncCartButtons();
  window.addEventListener('mg-cart-updated', syncCartButtons);
</script>
